node_modules
dist
out
.DS_Store
.eslintcache
# Narrow on purpose: *.log* also swallowed source files whose name contains
# ".log", and an ignored file is added by git add -A in silence.
*.log
*.log.[0-9]*
.tsbuildinfo-web
.tsbuildinfo-node

# testing ai generated code
.agents/
AGENTS.md
skills-lock.json
# Screenshot and browser automation debris. Nothing legitimate is a PNG at the repo root.
/*.png
/.playwright-mcp/

# Third party binary, fetched per build by scripts/fetch-fpcalc.mjs
/resources/bin/

# Build time secrets. Vite also loads .env.<mode> and .env.<mode>.local, and a
# production build runs in production mode, so cover the whole family.
.env
.env.*
!.env.example

# Vite writes its config here while it builds and leaves it behind when a build dies.
electron.vite.config.*.mjs
