{
	"extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
	"include": [
		"electron.vite.config.*",
		"vitest.config.*",
		"src/main/**/*",
		"src/preload/**/*",
		"src/shared/**/*"
	],
	"exclude": ["node_modules"],
	"compilerOptions": {
		"composite": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"types": ["electron-vite/node"],
		"baseUrl": ".",
		"paths": {
			"@main/*": ["src/main/*"],
			"@preload/*": ["src/preload/*"],
			"@shared/*": ["src/shared/*"],
			"@resources/*": ["resources/*"]
		},
		"incremental": true,
		"tsBuildInfoFile": "./.tsbuildinfo-node",
		"skipLibCheck": true,
		"noUncheckedIndexedAccess": true
	}
}
